{
  "name": "nucleo-filatelico-braga-website",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual Hugo website for N\u00facleo Filat\u00e9lico de Braga",
  "license": "CC-BY-4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/hugo.mjs --gc --minify --cleanDestinationDir && pagefind --site public",
    "start": "node scripts/hugo.mjs server --disableFastRender",
    "dev": "npm run start",
    "preview": "npm run build && python3 -m http.server 4173 --bind 127.0.0.1 --directory public",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "python3 scripts/check-site.py",
    "test": "npm run build && npm run check"
  },
  "dependencies": {
    "autoprefixer": "10.5.6",
    "hugo-extended": "0.166.0",
    "pagefind": "1.5.2",
    "postcss": "8.5.28",
    "postcss-cli": "11.0.1"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-go-template": "0.0.15"
  },
  "overrides": {
    "hugo-extended": {
      "adm-zip": "0.6.1"
    }
  }
}
