{
  "name": "nucleo-filatelico-braga-website",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual Hugo website for Núcleo Filatélico de Braga",
  "license": "CC-BY-4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/hugo.mjs --gc --minify --cleanDestinationDir && npm run build:pdf && pagefind --site public",
    "start": "node scripts/hugo.mjs server --disableFastRender",
    "dev": "npm run start",
    "preview": "npm run build && python3 -m http.server 4173 --bind 127.0.0.1 --directory public",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check-content.mjs && python3 scripts/check-site.py",
    "test": "npm run build && npm run check && npm run check:translations && npm run test:features",
    "check:translations": "node scripts/check-content.mjs --strict-translations",
    "test:features": "node scripts/check-features.mjs && node scripts/check-magazine.mjs",
    "build:pdf": "node scripts/build-magazine-pdfs.mjs",
    "issue:new": "node scripts/new-issue.mjs"
  },
  "dependencies": {
    "autoprefixer": "10.5.6",
    "hugo-extended": "0.166.0",
    "pagefind": "1.5.2",
    "postcss": "8.5.28",
    "postcss-cli": "11.0.1"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-go-template": "0.0.15",
    "yaml": "2.8.3"
  },
  "overrides": {
    "hugo-extended": {
      "adm-zip": "0.6.1"
    }
  }
}
